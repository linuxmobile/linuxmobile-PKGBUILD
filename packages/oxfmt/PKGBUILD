pkgname=oxfmt
pkgver=0.75.0
pkgrel=1
pkgdesc='High-performance formatter for the JavaScript ecosystem'
arch=('x86_64')
url='https://oxc.rs'
license=('MIT')
depends=('glibc' 'libgcc')
makedepends=('cargo')
optdepends=('oxlint')
provides=('oxfmt-bin')
conflicts=('oxfmt-bin')
replaces=('oxfmt-bin')
source=("oxc-${pkgname}_v${pkgver}.tar.gz::https://github.com/oxc-project/oxc/archive/refs/tags/${pkgname}_v${pkgver}.tar.gz")
sha256sums=('f268e2a0410a9c4f48ab91be0d439698181142825f3b5054c8cf52e905e4c803')
_src="oxc-${pkgname}_v${pkgver}"

prepare() {
  cd "$_src"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_src"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/usr/src"
  export CFLAGS="${CFLAGS} -ffat-lto-objects"
  export CXXFLAGS="${CXXFLAGS:-} -ffat-lto-objects"
  export CPPFLAGS="${CPPFLAGS:-} -ffat-lto-objects"
  cargo build --frozen --release -p oxfmt
}

package() {
  cd "$_src"
  install -Dm0755 target/release/oxfmt "$pkgdir/usr/bin/oxfmt"
  install -Dm0644 README.md "$pkgdir/usr/share/doc/${pkgname}/README.md"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
