# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=rhun
pkgver=0.19.2
pkgrel=1
pkgdesc='Small and fast code editor written in assembly'
arch=('x86_64')
url='https://github.com/vshvedov/rhun'
license=('MIT' 'OFL-1.1')
makedepends=('binutils')
optdepends=('git: integrated Git features'
            'xdg-utils: open links and reveal files'
            'curl: update checks and local AI model downloads')
provides=('rhun-bin')
conflicts=('rhun-bin')
replaces=('rhun-bin')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('3ce8ba3d3bf31d472ed8df77196478e18201bcbb15cd90f4e98ee3f080acde15')

_srcdir="${pkgname}-${pkgver}"

build() {
  cd "$_srcdir"
  RHUN_DIST=1 ./build.sh release
}

package() {
  cd "$_srcdir"

  install -Dm755 build/rhun "$pkgdir/usr/bin/rhun"
  install -Dm644 assets/rhun.desktop "$pkgdir/usr/share/applications/rhun.desktop"
  install -Dm644 assets/rhun-url-handler.desktop "$pkgdir/usr/share/applications/rhun-url-handler.desktop"
  install -Dm644 assets/icons/rhun.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/rhun.svg"
  install -Dm644 assets/icons/rhun-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/rhun.png"
  install -Dm644 assets/icons/rhun-512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/rhun.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 assets/licenses/LICENSE-Unicode.txt "$pkgdir/usr/share/licenses/${pkgname}/LICENSE-Unicode.txt"
  install -Dm644 assets/fonts/LICENSE-Iosevka.md "$pkgdir/usr/share/licenses/${pkgname}/LICENSE-Iosevka.md"
}
