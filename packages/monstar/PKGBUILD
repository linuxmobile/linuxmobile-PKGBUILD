# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=monstar
pkgver=1.4.1
pkgrel=1
pkgdesc='Linux-native Wayland terminal built on the Ghostty terminal core'
arch=('x86_64')
url='https://github.com/rockorager/monstar'
license=('MIT')
depends=(
  'dbus'
  'fontconfig'
  'freetype2'
  'glibc'
  'harfbuzz'
  'libxkbcommon'
  'wayland'
)
makedepends=(
  'ncurses'
  'vulkan-headers'
  'wayland-protocols>=1.49'
  'zig>=0.17.0'
)
optdepends=(
  'noto-fonts-emoji: emoji support'
  'noto-fonts-cjk: CJK font support'
  'systemd: launch additional terminal windows as user services'
  'vulkan-icd-loader: GPU rendering with renderer = vulkan'
  'xdg-desktop-portal: open links and files through a desktop portal'
  'xdg-utils: open links when a desktop portal is unavailable'
)
options=('!lto')
# Upstream publishes a self-contained source archive with its Zig dependencies.
source=("${pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/${pkgname}-${pkgver}-source.tar.gz")
sha256sums=('ce2feac87c14241b8373b82ba3c38610e6a8516cf857c4457fa612e5b1997724')

_srcdir="${pkgname}-${pkgver}"

prepare() {
  cd "$_srcdir"

  # Fetch the pinned Zig dependencies before the build so compilation stays
  # offline and a transient package mirror cannot interrupt the build step.
  zig build --fetch
}

build() {
  cd "$_srcdir"

  rm -rf "$srcdir/monstar-build"
  # Upstream defaults to baseline; pin the repository's x86-64-v3 target.
  DESTDIR="$srcdir/monstar-build" zig build \
    --prefix /usr \
    --build-id=sha1 \
    -Doptimize=fast \
    -Dcpu=x86_64_v3
}

package() {
  cd "$_srcdir"

  # The Zig build prefix already lays out bin/, desktop entry, icon,
  # terminfo, completions and man pages relative to /usr.
  cp -a "$srcdir/monstar-build/." "$pkgdir/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
