# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=opal
pkgver=0.9.6
pkgrel=1
pkgdesc='Native media player, streaming client, torrent player and local AI assistant'
arch=('x86_64')
url='https://github.com/debpalash/Opal'
license=('GPL-3.0-only')
depends=(
  'curl'
  'desktop-file-utils'
  'ffmpeg'
  'hicolor-icon-theme'
  'libtorrent-rasterbar'
  'mpv'
  'sdl2'
  'sqlite'
)
makedepends=(
  'gcc'
  'libwebp'
  'pkgconf'
  'zig>=0.17.1'
)
optdepends=(
  'onnxruntime: OCR bubble detection'
  'python: voice helper scripts'
  'streamlink: live stream resolution'
  'yt-dlp: YouTube playback and downloads'
)
provides=('opal-media-player' 'opal-media-player-bin')
conflicts=('opal-media-player' 'opal-media-player-bin')
replaces=('opal-media-player-bin')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('5e3b174151d11d8a38259e6cd952dff69ca9de39b3ad06410b44f9f175c4ebc9')

_srcdir="Opal-${pkgver}"

prepare() {
  cd "$_srcdir"
  [[ -f build.zig.zon && -f src/torrent_wrapper.cpp ]] || return 1
}

build() {
  cd "$_srcdir"

  g++ -std=c++17 -O3 -march=x86-64-v3 -mtune=generic -shared -fPIC \
    -Wl,-z,x86-64-v3 \
    src/torrent_wrapper.cpp \
    -o libtorrent_wrapper.so \
    -ltorrent-rasterbar

  zig build -Doptimize=ReleaseFast -fsys=sdl2 -Dcpu=x86_64_v3 \
    --prefix "$srcdir/build" \
    --cache-dir "$srcdir/.zig-cache"
}

package() {
  cd "$_srcdir"

  install -Dm755 "$srcdir/build/bin/opal" "$pkgdir/usr/bin/opal"
  install -Dm755 "$srcdir/build/bin/opal-mcp" "$pkgdir/usr/bin/opal-mcp"
  install -Dm755 libtorrent_wrapper.so "$pkgdir/usr/lib/opal/libtorrent_wrapper.so"

  cp -r engines "$pkgdir/usr/lib/opal/engines"
  install -Dm755 scripts/camoufox_bridge.py "$pkgdir/usr/lib/opal/scripts/camoufox_bridge.py"
  cp -r web "$pkgdir/usr/lib/opal/web"
  install -Dm644 assets/logo.svg "$pkgdir/usr/lib/opal/web/icon.svg"
  install -Dm644 data/plugins-manifest.json "$pkgdir/usr/lib/opal/plugins-manifest.json"
  install -Dm644 data/manga-sources-sfw.json "$pkgdir/usr/lib/opal/manga-sources-sfw.json"

  install -Dm644 packaging/opal.desktop "$pkgdir/usr/share/applications/opal.desktop"
  install -Dm644 assets/logo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/opal.svg"
  install -Dm644 docs/licenses/libwebp.txt "$pkgdir/usr/share/licenses/$pkgname/libwebp.txt"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
