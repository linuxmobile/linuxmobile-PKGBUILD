# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=ladybird
pkgver=2026.47.7
pkgrel=1
pkgdesc='Independent web browser with its own engine'
arch=('x86_64')
url='https://ladybird.org/'
license=('BSD-2-Clause' 'custom')
conflicts=('ladybird-git' 'ladybird-bin')
replaces=('ladybird-git' 'ladybird-bin')
options=('!strip' '!zipman')

# The alpha is a rolling release. Upstream only ships Linux binaries as Ubuntu
# and Fedora packages (plus a Flatpak), so repackage the Ubuntu amd64 .deb.
# The suffix is the pool filename published in
# https://apt.ladybird.org/dists/noble/main/binary-amd64/Packages
_debsuffix='1~ubuntu24.04'
_srcdir='ladybird-deb'

depends=(
  'gcc-libs'
  'glib2'
  'glibc'
  'hicolor-icon-theme'
  'libdrm'
  'libglvnd'
  'libpulse'
  'libx11'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'ttf-liberation'
  'vulkan-icd-loader'
  'wayland'
  'xcb-util'
  'xcb-util-cursor'
  'xcb-util-image'
  'xcb-util-keysyms'
  'xcb-util-renderutil'
)
source=("ladybird-${pkgver}-${_debsuffix}_amd64.deb::https://apt.ladybird.org/pool/main/l/ladybird/ladybird_${pkgver}-${_debsuffix}_amd64.deb")
sha256sums=('67e33f0a234b672734b8965ea7dd5c63c8f0b616313b91d43522c53ad686b1d4')

prepare() {
  mkdir -p "$_srcdir"
  bsdtar -xf data.tar.xz -C "$_srcdir"
}

package() {
  cp -a "${srcdir}/${_srcdir}/." "${pkgdir}/"

  install -Dm644 \
    "${srcdir}/${_srcdir}/opt/ladybird/share/Lagom/ladybird/LICENSES.txt.br" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSES.txt.br"
}
