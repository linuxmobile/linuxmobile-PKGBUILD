# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=cressida
pkgver=0.1.0.r186.gbf6c2ad
pkgrel=1
pkgdesc='Native Discord client written in C++ (Cressida)'
url='https://github.com/Ly-sec/Cressida'
license=('MIT' 'Apache-2.0' 'BSD-2-Clause')
arch=('x86_64')
depends=(
  'cairo'
  'curl'
  'ffmpeg'
  'fontconfig'
  'freetype2'
  'glib2'
  'harfbuzz'
  'libglvnd'
  'libjxl'
  'libpipewire'
  'libpulse'
  'librsvg'
  'libsecret'
  'libsodium'
  'libwebp'
  'libxkbcommon'
  'md4c'
  'mpv'
  'nlohmann-json'
  'noto-fonts-emoji'
  'openssl'
  'opus'
  'pango'
  'qrencode'
  'rlottie'
  'shared-mime-info'
  'stb'
  'tomlplusplus'
  'wayland'
  'zstd'
)
makedepends=(
  'git'
  'meson'
  'ninja'
  'pkgconf'
  'wayland-protocols'
)
source=("cressida::git+https://github.com/Ly-sec/Cressida.git")
sha256sums=('SKIP')

_srcdir='cressida'

pkgver() {
  cd "$_srcdir"
  local ver
  ver="$(sed 's/^v//' VERSION)"
  printf '%s.r%s.g%s' "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$_srcdir"
  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    -Dtests=disabled \
    -Demoji_font=/usr/share/fonts/noto/NotoColorEmoji.ttf
  ninja -C build
}

package() {
  cd "$_srcdir"
  DESTDIR="$pkgdir" ninja -C build install
}
