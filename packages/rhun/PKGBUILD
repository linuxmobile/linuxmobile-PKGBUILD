
pkgname=rhun
pkgver=0.19.1
pkgrel=1
pkgdesc='Small and fast code editor written in assembly'
arch=('x86_64')
url='https://github.com/vshvedov/rhun'
license=('MIT' 'OFL-1.1')
makedepends=('binutils')
optdepends=('git: integrated Git features'
            'xdg-utils: open links and reveal files'
            'curl: update checks and local AI model downloads')
provides=('rhun-bin')
conflicts=('rhun-bin')
replaces=('rhun-bin')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('fe09fc611ccc1776fdf104895eb12c4483ab5a019ec096b3f1abc4d90e8fbc07')

build() {
  cd "${pkgname}-${pkgver}"
  RHUN_DIST=1 ./build.sh release
}

package() {
  cd "${pkgname}-${pkgver}"

  install -Dm0755 build/rhun "$pkgdir/usr/bin/rhun"
  install -Dm0644 assets/rhun.desktop "$pkgdir/usr/share/applications/rhun.desktop"
  install -Dm0644 assets/rhun-url-handler.desktop "$pkgdir/usr/share/applications/rhun-url-handler.desktop"
  install -Dm0644 assets/icons/rhun.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/rhun.svg"
  install -Dm0644 assets/icons/rhun-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/rhun.png"
  install -Dm0644 assets/icons/rhun-512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/rhun.png"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm0644 assets/licenses/LICENSE-Unicode.txt "$pkgdir/usr/share/licenses/${pkgname}/LICENSE-Unicode.txt"
  install -Dm0644 assets/fonts/LICENSE-Iosevka.md "$pkgdir/usr/share/licenses/${pkgname}/LICENSE-Iosevka.md"
}
