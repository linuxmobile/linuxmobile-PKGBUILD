# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=jcode
pkgver=1.0.2
pkgrel=1
pkgdesc='High-performance coding agent harness for parallel multi-agent workflows'
arch=('x86_64')
url='https://github.com/1jehuang/jcode'
license=('MIT')
depends=(
  'glibc'
  'gcc-libs'
  'brotli'
  'openssl'
  'zlib'
  'zstd'
)
makedepends=(
  'cargo'
  'clang'
  'cmake'
  'perl'
  'pkgconf'
)
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('c1e09e34ca0f3bd4d179326fe151cf03c85c6fc843096f454b8383a7eb6e0383')

_srcdir="${pkgname}-${pkgver}"

prepare() {
  cd "$_srcdir"
  # Upstream's .cargo/config.toml installs a POSIX-shell rustc wrapper that
  # enables nightly-only `-Zthreads` and caps jobs at 4. Upstream CI clears it
  # for release builds; do the same here so the stable build is deterministic
  # and can use the job count from makepkg.conf.
  : > .cargo/config.toml
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/usr/src/debug/${pkgname}"
  # The source tarball has no .git, so without these the build script walks up
  # into this repository and reports a dev version from *its* commits. Mirror
  # upstream's release workflow to get a clean `v${pkgver}` identity instead.
  export JCODE_RELEASE_BUILD=1
  export JCODE_CI_BUILD=1
  export JCODE_BUILD_SEMVER="v${pkgver}"
  export JCODE_BUILD_GIT_HASH='unknown'
  export JCODE_BUILD_GIT_TAG="v${pkgver}"
  export JCODE_BUILD_GIT_DIRTY=0
  cargo build --frozen --release --locked --bin jcode
}

package() {
  cd "$_srcdir"
  install -Dm755 target/release/jcode "${pkgdir}/usr/bin/jcode"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
