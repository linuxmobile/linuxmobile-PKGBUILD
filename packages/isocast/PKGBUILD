# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=isocast
pkgver=0.0.10.r42.ga951d6a
pkgrel=1
url='https://github.com/anomalyco/isocast'
pkgdesc='Screen and camera recorder that records every source as its own file'
arch=(x86_64)
license=('MIT OR Apache-2.0')
depends=(alsa-lib
         fontconfig
         freetype2
         gtk4
         webkitgtk-6.0
         openssl
         'libpipewire>=1.0.5'
         gstreamer
         gst-plugins-base
         gst-plugins-good
         gst-libav
         'openh264>=2.6'
         'libopenh264.so=8-64'
         vulkan-icd-loader
         vulkan-driver
         libglvnd
         wayland
         libxkbcommon)
makedepends=(cargo
             clang
             cmake
             git
             nasm)
provides=('isocast-git')
conflicts=('isocast-git')
replaces=('isocast-git')
options=('!lto' '!debug')
source=("isocast::git+${url}.git")
sha256sums=('SKIP')

_srcdir='isocast'

prepare() {
  cd "$_srcdir"
  export CARGO_HOME="$srcdir"
  export CARGO_PROFILE_RELEASE_OPT_LEVEL=3
  export CARGO_PROFILE_RELEASE_LTO=false
  export CARGO_BUILD_JOBS=2
  export CARGO_TARGET_DIR=target
  export NINJA_JOBS=2
  export RUSTUP_TOOLCHAIN=stable
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/usr/src"
  export CFLAGS="${CFLAGS} -fno-lto -ffile-prefix-map=${srcdir}=/usr/src"
  export CXXFLAGS="${CXXFLAGS:-} -ffile-prefix-map=${srcdir}=/usr/src"
  cargo fetch --locked
}

pkgver() {
  cd "$_srcdir"
  git describe --long --tags --abbrev=7 --match="v*" HEAD |
      sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "$_srcdir"
  export CARGO_HOME="$srcdir"
  export CARGO_PROFILE_RELEASE_OPT_LEVEL=3
  export CARGO_PROFILE_RELEASE_LTO=false
  export CARGO_BUILD_JOBS=2
  export CARGO_TARGET_DIR=target
  export NINJA_JOBS=2
  export RUSTUP_TOOLCHAIN=stable
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/usr/src"
  export CFLAGS="${CFLAGS} -fno-lto -ffile-prefix-map=${srcdir}=/usr/src"
  export CXXFLAGS="${CXXFLAGS:-} -ffile-prefix-map=${srcdir}=/usr/src"
  cargo build --frozen --release \
    -p isocast-cli \
    -p isocast-daemon \
    -p isocast-ui \
    -p isocast-browser
}

package() {
  cd "$_srcdir"
  install -Dm755 -t "$pkgdir/usr/bin/" "target/release/$pkgname"{,d,-ui,-browser}
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE-{APACHE,MIT}
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname/" THIRD_PARTY_NOTICES \
    packaging/linux/CISCO_H264_LICENSE.txt

  install -Dm644 "packaging/linux/dev.isocast.Isocast.desktop" "$pkgdir/usr/share/applications/dev.isocast.Isocast.desktop"
  install -dm755 "$pkgdir/usr/share/icons"
  cp -r "packaging/linux/icons/hicolor" "$pkgdir/usr/share/icons/"
}
