# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=herdr-tui
pkgver=0.9.5
pkgrel=1
pkgdesc='Terminal workspace manager for AI coding agents (TUI)'
arch=('x86_64')
url='https://github.com/herdrdev/herdr'
license=('Apache-2.0')
depends=(
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
  'git'
)
provides=('herdr')
conflicts=('herdr' 'herdr-bin' 'herdr-git')
replaces=('herdr' 'herdr-bin' 'herdr-git')
options=('!lto')
# libghostty-vt requires Zig 0.16; Arch ships a newer Zig, so use the
# upstream-pinned toolchain from a verified tarball instead of pacman's zig.
_zig_version=0.16.0
_zig_archive="zig-x86_64-linux-${_zig_version}.tar.xz"
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
  "https://ziglang.org/download/${_zig_version}/${_zig_archive}"
)
sha256sums=(
  'a2486b09a8153630f6a19e72606ba1c961a6194bce13c09cba67ccce5e4252de'
  '70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00'
)

_srcdir="herdr-${pkgver}"

prepare() {
  cd "$_srcdir"

  bsdtar -xf "$srcdir/$_zig_archive" -C "$srcdir"
  local zig="$srcdir/zig-x86_64-linux-${_zig_version}/zig"
  [[ -x "$zig" ]] || { printf 'error: Zig %s missing from source archive\n' "$_zig_version" >&2; return 1; }

  export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-cache"
  export PATH="$(dirname "$zig"):$PATH"

  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"

  # The vendored Ghostty VT library resolves its own Zig dependencies.
  (
    cd vendor/libghostty-vt || exit 1
    local attempt
    for attempt in 1 2 3; do
      if "$zig" build --fetch=all; then
        exit 0
      fi
      (( attempt < 3 )) && sleep 2
    done
    exit 1
  ) || return 1
}

build() {
  cd "$_srcdir"

  local zig="$srcdir/zig-x86_64-linux-${_zig_version}/zig"
  export CARGO_TARGET_DIR=target
  export ZIG="$zig"
  export PATH="$(dirname "$zig"):$PATH"
  export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-cache"
  export HERDR_BUILD_CHANNEL=stable
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"

  cargo build --release --frozen
}

package() {
  cd "$_srcdir"

  install -Dm755 target/release/herdr "$pkgdir/usr/bin/herdr"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  install -d "$pkgdir/usr/share/bash-completion/completions"
  install -d "$pkgdir/usr/share/fish/vendor_completions.d"
  install -d "$pkgdir/usr/share/zsh/site-functions"
  target/release/herdr completion bash > "$pkgdir/usr/share/bash-completion/completions/herdr"
  target/release/herdr completion fish > "$pkgdir/usr/share/fish/vendor_completions.d/herdr.fish"
  target/release/herdr completion zsh > "$pkgdir/usr/share/zsh/site-functions/_herdr"
}
