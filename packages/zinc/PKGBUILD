# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=zinc
pkgver=0.2.1.r137.g0c69ec0
pkgrel=1
pkgdesc='High-performance Wayland terminal emulator written in Zig'
arch=('x86_64')
url='https://github.com/Mvkweb/zinc'
license=('MIT')

provides=('zinc-term')
conflicts=('zinc-term' 'zinc-term-git')
replaces=('zinc-term' 'zinc-term-git')

depends=(
  'glibc'
  'wayland'
  'libxkbcommon'
  'freetype2'
  'fontconfig'
  'hicolor-icon-theme'
)
makedepends=(
  'git'
  'pkgconf'
  'zig>=0.17.0'
  'wayland'
  'libxkbcommon'
  'freetype2'
  'fontconfig'
)

# makepkg names the git clone after the source alias.
# Track the linuxmobile fork's linux-build branch until the changes land upstream.
_srcdir='zinc'
_giturl='https://github.com/linuxmobile/zinc.git'
source=("${_srcdir}::git+${_giturl}#branch=linux-build")
sha256sums=('SKIP')

pkgver() {
  cd "$_srcdir" || return 1
  # Guard the checkout: without it a failed cd leaves us in this PKGBUILD's
  # repository and git would report the wrong history as zinc's version.
  if [[ ! -d .git ]]; then
    printf 'pkgver() needs the %s source checkout\n' "$_srcdir" >&2
    return 1
  fi

  local version commit_count commit
  version=$(sed -n 's/^[[:space:]]*\.version[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' build.zig.zon | head -n1)
  if [[ -z "$version" ]]; then
    printf 'pkgver() could not read the version from build.zig.zon\n' >&2
    return 1
  fi
  commit_count=$(git rev-list --count HEAD)
  commit=$(git rev-parse --short=7 HEAD)
  printf '%s.r%s.g%s\n' "$version" "$commit_count" "$commit"
}

prepare() {
  cd "$_srcdir"

  # The roundtrip test publishes a developer-specific cwd that does not exist
  # in a clean build container; read() rejects records whose path is not a
  # directory. Point just that test at /, which always exists. The separate
  # "nonexistent directory" test keeps its missing path and still covers the
  # rejection branch.
  if ! grep -q 'publish(pid, "/mnt/data/dev/zinc");' src/session.zig ||
     ! grep -q 'expectEqualStrings("/mnt/data/dev/zinc", res.?);' src/session.zig; then
    printf 'prepare(): zinc changed the session roundtrip test\n' >&2
    return 1
  fi
  sed -i 's#publish(pid, "/mnt/data/dev/zinc");#publish(pid, "/");#' src/session.zig
  sed -i 's#expectEqualStrings("/mnt/data/dev/zinc", res.?);#expectEqualStrings("/", res.?);#' src/session.zig
}

build() {
  cd "$_srcdir"

  # Same v3 pin as the lui PKGBUILD. Zig owns codegen and linking here, so
  # there is no separate -march/-Wl,-z,x86-64-v3 step like in the C/Rust
  # recipes; the CPU target is selected directly in the compiler invocation.
  zig build -Doptimize=ReleaseFast -Dcpu=x86_64_v3 -Dversion="$pkgver" \
    --prefix "$srcdir/build" \
    --cache-dir "$srcdir/.zig-cache"
}

check() {
  cd "$_srcdir"

  zig build test -Dcpu=x86_64_v3 \
    --cache-dir "$srcdir/.zig-cache"
}

package() {
  cd "$_srcdir"

  # The build prefix already lays out bin/, desktop entry, AppStream
  # metadata and the full hicolor icon tree relative to /usr.
  cp -a "$srcdir/build/." "$pkgdir/usr/"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
