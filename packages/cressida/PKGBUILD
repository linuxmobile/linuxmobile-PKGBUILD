pkgname=cressida
pkgver=0.1.0
pkgrel=1
pkgdesc='Native Discord client written in C++ (Cressida)'
url='https://github.com/Ly-sec/Cressida'
license=('MIT' 'Apache-2.0' 'BSD-2-Clause')
arch=('x86_64')
depends=(
  'cairo'
  'curl'
  'ffmpeg'
  'fontconfig'
  'freetype2'
  'glib2'
  'harfbuzz'
  'libglvnd'
  'libjxl'
  'libpipewire'
  'libpulse'
  'libsecret'
  'libsodium'
  'libwebp'
  'libxkbcommon'
  'md4c'
  'mpv'
  'nlohmann-json'
  'noto-fonts-emoji'
  'openssl'
  'opus'
  'pango'
  'qrencode'
  'rlottie'
  'shared-mime-info'
  'stb'
  'tomlplusplus'
  'wayland'
  'zstd'
)
makedepends=(
  'git'
  'meson'
  'ninja'
  'pkgconf'
  'wayland-protocols'
)
source=("${pkgname}::git+https://github.com/Ly-sec/Cressida.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cd "${pkgname}"
  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    -Dtests=disabled \
    -Demoji_font=/usr/share/fonts/noto/NotoColorEmoji.ttf
  ninja -C build
}

package() {
  cd "${pkgname}"
  DESTDIR="$pkgdir" ninja -C build install
}
