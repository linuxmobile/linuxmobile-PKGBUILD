# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=lui
pkgver=0.11.8
pkgrel=1
pkgdesc='TUI file manager written in Zig'
arch=('x86_64')
url='https://codeberg.org/lukeflo/lui'
license=('GPL-3.0-or-later')
depends=('glibc')
makedepends=('zig')
source=("${pkgname}-${pkgver}.tar.gz::https://codeberg.org/lukeflo/lui/archive/c1253db4c35713365a94ce5ee9b39d0d397989e3.tar.gz")
sha256sums=('13e80116bcd805992fd31fb8fa947e8ffd74faa530bee2652be16e9f967b0407')

_srcdir='lui'

build() {
  cd "$_srcdir"
  zig build -Doptimize=ReleaseFast -Dcpu=x86_64_v3 \
    --prefix "$srcdir/build" \
    --cache-dir "$srcdir/.zig-cache"
}

package() {
  cd "$_srcdir"

  install -Dm755 "$srcdir/build/bin/lui" "$pkgdir/usr/bin/lui"
  install -Dm644 etc/luiconfig.zon "$pkgdir/usr/share/doc/${pkgname}/luiconfig.zon"
  install -Dm644 README.md "$pkgdir/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
