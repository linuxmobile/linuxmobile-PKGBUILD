# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=lui
pkgver=0.12.3
pkgrel=1
pkgdesc='TUI file manager written in Zig'
arch=('x86_64')
url='https://codeberg.org/lukeflo/lui'
license=('GPL-3.0-or-later')
depends=('glibc')
makedepends=('zig')
_commit=90ec5ac30512910f42d5151b0ffdbd16cdea4431
source=("${pkgname}-${pkgver}-${_commit}.tar.gz::https://codeberg.org/lukeflo/lui/archive/${_commit}.tar.gz")
sha256sums=('8f998ce272243486a73c3c6fd7d73c9433a2279db67918348a3f4541f81b4441')

_srcdir='lui'

build() {
  cd "$_srcdir"
  zig build -Doptimize=ReleaseFast -Dcpu=x86_64_v3 \
    --prefix "$srcdir/build" \
    --cache-dir "$srcdir/.zig-cache"
}

package() {
  cd "$_srcdir"

  install -Dm755 "$srcdir/build/bin/lui" "$pkgdir/usr/bin/lui"
  install -Dm644 etc/luiconfig.zon "$pkgdir/usr/share/doc/${pkgname}/luiconfig.zon"
  install -Dm644 README.md "$pkgdir/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
