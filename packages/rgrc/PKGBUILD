# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=rgrc
pkgver=0.6.35.r2.gb3e3126
pkgrel=1
pkgdesc='Rusty Generic Colouriser - like grc but faster and with more features'
arch=('x86_64')
url='https://github.com/lazywalker/rgrc'
license=('MIT')
depends=(
  'glibc'
  'gcc-libs'
)
makedepends=(
  cargo
  git
)
options=('!lto')
source=("${pkgname}::git+${url}#branch=master")
sha256sums=('SKIP')

_srcdir='rgrc'

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

pkgver() {
  cd "$_srcdir"
  git describe --long --tags --abbrev=7 | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/^v//'
}

build() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
  cargo build --frozen --release --no-default-features

  target/release/${pkgname} --completions=zsh > etc/_${pkgname}
  target/release/${pkgname} --completions=bash > etc/${pkgname}
  target/release/${pkgname} --completions=fish > etc/${pkgname}.fish

  gzip -fk doc/rgrc.1
}

package() {
  cd "$_srcdir"

  install -Dm755 "target/release/${pkgname}" -t "${pkgdir}/usr/bin/"
  install -Dm644 etc/rgrc.conf -t "${pkgdir}/etc/"
  install -Dm644 share/conf.* -t "${pkgdir}/usr/share/${pkgname}/"

  install -Dm644 etc/_${pkgname} -t "${pkgdir}/usr/share/zsh/site-functions/"
  install -Dm644 etc/${pkgname} -t "${pkgdir}/usr/share/bash-completion/completions/"
  install -Dm644 etc/${pkgname}.fish -t "${pkgdir}/usr/share/fish/vendor_completions.d/"

  install -Dm644 doc/rgrc.1.gz -t "${pkgdir}/usr/share/man/man1/"

  install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
