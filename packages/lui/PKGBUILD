# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=lui
pkgver=0.11.8
pkgrel=2
pkgdesc='TUI file manager written in Zig'
arch=('x86_64')
url='https://codeberg.org/lukeflo/lui'
license=('GPL-3.0-or-later')
depends=('glibc')
makedepends=('zig')
_commit=5062dc090c6eaf6aec5ffad5fdce6b467d941814
source=("${pkgname}-${pkgver}-${_commit}.tar.gz::https://codeberg.org/lukeflo/lui/archive/${_commit}.tar.gz")
sha256sums=('f95052d2668b0fec792db258359269919ab8a1ca953f1f7fcb728c4ec4e8d984')

_srcdir='lui'

build() {
  cd "$_srcdir"
  zig build -Doptimize=ReleaseFast -Dcpu=x86_64_v3 \
    --prefix "$srcdir/build" \
    --cache-dir "$srcdir/.zig-cache"
}

package() {
  cd "$_srcdir"

  install -Dm755 "$srcdir/build/bin/lui" "$pkgdir/usr/bin/lui"
  install -Dm644 etc/luiconfig.zon "$pkgdir/usr/share/doc/${pkgname}/luiconfig.zon"
  install -Dm644 README.md "$pkgdir/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
