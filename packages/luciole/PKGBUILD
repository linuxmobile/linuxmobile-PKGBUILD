# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=luciole
pkgver=0.1.0.r468.g91f9a76b2
pkgrel=1
pkgdesc='Native Wayland file manager with fast previews, tabs, split view and Miller columns'
arch=('x86_64')
url='https://github.com/noctalia-dev/luciole'
license=('MIT')
depends=(
  'acl'
  'adwaita-icon-theme'
  'cairo'
  'curl'
  'dconf'
  'fontconfig'
  'freetype2'
  'gcc-libs'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gsettings-desktop-schemas'
  'gvfs'
  'harfbuzz'
  'hicolor-icon-theme'
  'libarchive'
  'libglvnd'
  'libpng'
  'librsvg'
  'libxkbcommon'
  'libxml2'
  'pango'
  'shared-mime-info'
  'tomlplusplus'
  'wayland'
  'xz'
)
makedepends=(
  'git'
  'meson'
  'ninja'
  'nlohmann-json'
  'pkgconf'
  'stb'
  'wayland-protocols>=1.49'
)
optdepends=(
  'ffmpeg: video and audio thumbnails and metadata'
  'ffmpegthumbnailer: filmstrip edges on video thumbnails'
  'poppler: PDF thumbnails and metadata'
  '7zip: encrypted 7z archives'
  'gvfs-smb: SMB network locations'
  'gvfs-dnssd: WebDAV and DNS-SD discovery'
  'glib-networking: secure WebDAV (TLS)'
  'xdg-terminal-exec: automatic terminal selection'
  'xdg-desktop-portal: use Luciole as the Open and Save file picker'
)
provides=('luciole-git')
conflicts=('luciole-git')
replaces=('luciole-git')
# No debug package: the ISA validator expects one archive per package.
options=('!debug')
# Upstream does not tag releases; track main like the AUR luciole-git package.
source=("${pkgname}::git+${url}.git#branch=main")
sha256sums=('SKIP')

_srcdir="$pkgname"

pkgver() {
  cd "$_srcdir"
  local ver
  ver="$(tr -d '[:space:]' < VERSION)"
  printf '%s.r%s.g%s' "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short=9 HEAD)"
}

prepare() {
  cd "$_srcdir"
  # Guard against an incomplete checkout giving pkgver() a wrong revision.
  git rev-parse --verify HEAD >/dev/null
}

build() {
  cd "$_srcdir"
  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    -Db_ndebug=true \
    -Dtests=disabled \
    -Dbuild_revision="$(git rev-parse --short=9 HEAD)"
  ninja -C build
}

package() {
  cd "$_srcdir"
  DESTDIR="$pkgdir" meson install -C build
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
