pkgname=kavita
pkgver=0.9.1.4
pkgrel=1
pkgdesc='Self hosted ebook and comic reader'
arch=('x86_64')
url='https://www.kavitareader.com/'
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs' 'icu' 'libgdiplus' 'openssl' 'zlib' 'curl' 'tzdata')
makedepends=('dotnet-sdk' 'nodejs' 'npm')
provides=('kavita-bin')
conflicts=('kavita-bin')
replaces=('kavita-bin')
backup=('etc/Kavita/appsettings.json')
install=kavita.install
options=('!debug' '!strip')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/Kareadita/Kavita/archive/refs/tags/v${pkgver}.tar.gz"
        kavita.install
        kavita.service
        kavita.sysusers
        kavita.tmpfiles)
sha256sums=('7432e957f806285f2219a493a6f6d9bde6f940e2a771cbfb36b8f894abe3f13a'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

prepare() {
  cd "Kavita-${pkgver}/UI/Web"
  npm ci --legacy-peer-deps
}

build() {
  cd "Kavita-${pkgver}"

  (
    cd UI/Web
    npm run prod
    mkdir -p ../../Kavita.Server/wwwroot
    rm -rf ../../Kavita.Server/wwwroot/*
    cp -r dist/browser/* ../../Kavita.Server/wwwroot/
  )

  export DOTNET_CLI_TELEMETRY_OPTOUT=1
  export DOTNET_NOLOGO=1
  export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

  dotnet publish Kavita.Server/Kavita.Server.csproj \
    --configuration Release \
    --runtime linux-x64 \
    --self-contained true \
    --output "$srcdir/publish" \
    -p:PublishReadyToRun=true \
    -p:UseAppHost=true \
    -p:DebugType=none
}

package() {
  cd "Kavita-${pkgver}"

  install -d "$pkgdir/opt/kavita"
  cp -Ra "$srcdir/publish/." "$pkgdir/opt/kavita/"

  install -Dm0644 Kavita.Server/config/appsettings.json "$pkgdir/etc/Kavita/appsettings.json"
  install -dm0755 "$pkgdir/opt/kavita/config"
  rm -f "$pkgdir/opt/kavita/config/appsettings.json"
  ln -s /etc/Kavita/appsettings.json "$pkgdir/opt/kavita/config/appsettings.json"

  install -Dm0644 "$srcdir/kavita.sysusers" "$pkgdir/usr/lib/sysusers.d/${pkgname}.conf"
  install -Dm0644 "$srcdir/kavita.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/${pkgname}.conf"
  install -Dm0644 "$srcdir/kavita.service" "$pkgdir/usr/lib/systemd/system/kavita.service"
}
