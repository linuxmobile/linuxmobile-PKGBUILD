# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=netwatch
pkgver=0.39.0
pkgrel=1
pkgdesc='Real-time network diagnostics in your terminal'
arch=('x86_64')
url='https://github.com/matthart1983/netwatch'
license=('MIT')
depends=('glibc' 'gcc-libs' 'libpcap' 'iproute2')
makedepends=('cargo' 'pkgconf')
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('b3096edb78aec785f5a066c17cacc640f72bc95084418268295dbeaddfd7dfa2')

_srcdir="${pkgname}-${pkgver}"

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
  cargo build --frozen --release
}

package() {
  cd "$_srcdir"
  install -Dm755 "target/release/netwatch" "$pkgdir/usr/bin/netwatch"
  install -Dm644 completions/netwatch.bash "$pkgdir/usr/share/bash-completion/completions/netwatch"
  install -Dm644 completions/_netwatch "$pkgdir/usr/share/zsh/site-functions/_netwatch"
  install -Dm644 completions/netwatch.fish "$pkgdir/usr/share/fish/vendor_completions.d/netwatch.fish"
  install -Dm644 README.md "$pkgdir/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
