# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=hibiki
pkgver=0.2.0
pkgrel=1
pkgdesc="A high-fidelity keystroke and bubble visualizer for Wayland"
arch=('x86_64')
url="https://github.com/linuxmobile/hibiki"
license=('MIT')
depends=(
  'gtk4'
  'gtk4-layer-shell'
  'libxkbcommon'
  'dbus'
  'alsa-lib'
  'fontconfig'
)
makedepends=(
  'cargo'
  'pkgconf'
  'jack'
)
optdepends=(
  'pipewire-jack: JACK audio backend'
  'jack2: JACK audio backend'
)
replaces=('hibiki-bin')
conflicts=('hibiki-bin')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('b4eea7617a81954778a3181497d05d665a815da249dc810475f51e3f58f36ba2')

_srcdir="${pkgname}-${pkgver}"

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
  cargo build --release --frozen
}

package() {
  cd "$_srcdir"

  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 assets/hibiki.desktop "$pkgdir/usr/share/applications/hibiki.desktop"
  install -Dm644 assets/hibiki.metainfo.xml "$pkgdir/usr/share/metainfo/hibiki.metainfo.xml"
  install -Dm644 assets/hibiki.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/hibiki.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
