pkgname=isocast
_pkgname=isocast
pkgver=0.0.9.r32.g591a5b8
pkgrel=1
url="https://$_pkgname.xyz"
_url="https://github.com/R44VC0RP/$_pkgname"
pkgdesc='OBS alternative that records every source as its own file'
arch=(x86_64)
license=(MIT Apache-2.0)
depends=(alsa-lib
         fontconfig
         glibc
         gst-plugins-base-libs
         libgcc
         libpipewire
         openh264)
makedepends=(cargo
             clang
             cmake
             git)
provides=('isocast-git')
conflicts=('isocast-git')
replaces=('isocast-git')
source=("git+$_url.git")
sha256sums=('SKIP')

_srcenv() {
	cd "$_pkgname"
	export CARGO_HOME="$srcdir"
	export CARGO_PROFILE_RELEASE_OPT_LEVEL=3
	export CARGO_PROFILE_RELEASE_LTO=false
	export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16
	export CARGO_BUILD_JOBS=2
	export CARGO_TARGET_DIR=target
	export NINJA_JOBS=2
	export RUSTUP_TOOLCHAIN=stable
	export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/usr/src"
	export CFLAGS="${CFLAGS} -fno-lto -ffile-prefix-map=${srcdir}=/usr/src"
	export CXXFLAGS="${CXXFLAGS:-} -ffile-prefix-map=${srcdir}=/usr/src"
}

prepare() {
	_srcenv
	cargo fetch --locked
}

pkgver() {
	cd "$_pkgname"
	git describe --long --tags --abbrev=7 --match="v*" HEAD |
			sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
	_srcenv
	cargo build --frozen --release
}

package() {
	cd "$_pkgname"
	install -Dm0755 -t "$pkgdir/usr/bin/" "target/release/$_pkgname"{,d,-ui}
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE-{APACHE,MIT}
}
