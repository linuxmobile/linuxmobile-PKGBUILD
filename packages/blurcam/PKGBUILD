# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=blurcam
pkgver=0.2.0
pkgrel=1
pkgdesc='Real-time face and licence plate blurring for video and webcams'
arch=('x86_64')
url='https://github.com/r3dg0d/blurcam'
license=('MIT')
depends=(
  'curl'
  'ffmpeg'
  'gcc-libs'
  'glibc'
  'opencv'
  'openssl'
  'sdl2'
)
makedepends=(
  'cli11'
  'cmake'
  'pkgconf'
  'tomlplusplus'
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('c93caf01c2ffbb9719c73f3d0cb027d59f0d8c8167540cba7d73a82696e76eea')

_srcdir="${pkgname}-${pkgver}"

prepare() {
  cd "$_srcdir"
  sed -i 's/find_package(OpenCV 4\.8 REQUIRED COMPONENTS core imgproc imgcodecs objdetect video dnn/find_package(OpenCV 5.0 REQUIRED COMPONENTS core imgproc imgcodecs objdetect video dnn features/' CMakeLists.txt
  sed -i 's|#include <opencv2/video/tracking.hpp>|#include <opencv2/video/tracking.hpp>\n#include <opencv2/features.hpp>|' src/tracking.cpp
}

build() {
  cd "$_srcdir"

  cmake -S . -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF \
    -Wno-author

  cmake --build build --parallel
}

package() {
  cd "$_srcdir"

  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 README.md "$pkgdir/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
