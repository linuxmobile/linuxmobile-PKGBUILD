+  },
+} as const;
+
+type Light = keyof (typeof ART)["light"];
+
+export type TrafficLightsPlace = { center: readonly [number, number]; trailing: boolean };
+
+const DEFAULT_PLACE: TrafficLightsPlace = { center: DEFAULT_CENTER, trailing: false };
+const places = new Map<string, TrafficLightsPlace>();
+const watchers = new Set<() => void>();
+
+export function setTrafficLightsCenter(windowId: string, next: readonly [number, number] | null, trailing = false) {
+  if (next) places.set(windowId, { center: [next[0], next[1]], trailing });
+  else places.delete(windowId);
+  for (const watcher of watchers) watcher();
+  return Promise.resolve();
+}
+
+export const trafficLightsOffWindow = ({ center, trailing }: TrafficLightsPlace): boolean =>
+  lightsOffWindow(trailing ? [center[0], center[1], "right"] : [center[0], center[1]]);
+
+export function trafficLightPosition({ center, trailing }: TrafficLightsPlace, index: number) {
+  const top = center[1] - DIAMETER / 2;
+  return trailing ? { right: center[0] - index * SPACING - DIAMETER / 2, top } : { left: center[0] + index * SPACING - DIAMETER / 2, top };
+}
+
+export function TrafficLight({ name, theme }: { name: Light; theme: keyof typeof ART }) {
+  const { interior, rim } = ART[theme][name];
+  const id = `ardia-light-${theme}-${name}`;
+  const r = DIAMETER / 2;
+  return (
+    <svg width={DIAMETER} height={DIAMETER} viewBox={`0 0 ${DIAMETER} ${DIAMETER}`} style={{ display: "block" }}>
+      <defs>
+        <linearGradient id={`${id}-fill`} x1="0" y1="0" x2="0" y2="1">
+          {interior.map((color, i) => (
+            <stop key={i} offset={STOPS[i]} style={{ stopColor: color }} />
+          ))}
+        </linearGradient>
+        <linearGradient id={`${id}-rim`} x1="0" y1="0" x2="0" y2="1">
+          {rim.map((color, i) => (
+            <stop key={i} offset={STOPS[i]} style={{ stopColor: color }} />
+          ))}
+        </linearGradient>
+      </defs>
+      <circle cx={r} cy={r} r={r - RIM / 2} fill={`url(#${id}-fill)`} stroke={`url(#${id}-rim)`} strokeWidth={RIM} />
+    </svg>
+  );
+}
+
+export const trafficLightsPlace = (windowId: string) => places.get(windowId) ?? DEFAULT_PLACE;
+
+export function useTrafficLightsPlace(windowId: string) {
+  return useSyncExternalStore((watch) => (watchers.add(watch), () => void watchers.delete(watch)), () => trafficLightsPlace(windowId));
+}
