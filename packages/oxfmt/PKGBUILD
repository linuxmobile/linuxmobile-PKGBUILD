# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=oxfmt
pkgver=0.80.0
pkgrel=1
pkgdesc='High-performance formatter for the JavaScript ecosystem'
arch=('x86_64')
url='https://oxc.rs'
license=('MIT')
depends=('glibc' 'libgcc')
makedepends=('cargo')
optdepends=('oxlint')
provides=('oxfmt-bin')
conflicts=('oxfmt-bin')
replaces=('oxfmt-bin')
options=('!lto')
source=("oxc-${pkgname}_v${pkgver}.tar.gz::https://github.com/oxc-project/oxc/archive/refs/tags/${pkgname}_v${pkgver}.tar.gz")
sha256sums=('d27091d9dd412e397bc6bb644028d9b420c6bf9ef5b328eeb229794544aa5a67')

_srcdir="oxc-${pkgname}_v${pkgver}"

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
  # The default `napi` feature is only for the Node.js binding; the CLI
  # panics at startup when it is compiled in (no external services are set).
  cargo build --frozen --release -p oxfmt --no-default-features
}

package() {
  cd "$_srcdir"
  install -Dm755 target/release/oxfmt "$pkgdir/usr/bin/oxfmt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
