# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=droidloom-runtime
pkgver=0.1.0
pkgrel=30
pkgdesc='Android applications in native Wayland windows'
arch=('x86_64')
url='https://github.com/denialwm/droidloom'
license=('GPL-3.0-or-later')
options=('!strip' '!debug' '!lto' '!purge')
source=("${pkgname}-${pkgver}-${pkgrel}-x86_64-upstream.pkg.tar.zst::https://github.com/denialwm/droidloom/releases/download/packages/${pkgname}-${pkgver}-${pkgrel}-x86_64.pkg.tar.zst")
noextract=("${pkgname}-${pkgver}-${pkgrel}-x86_64-upstream.pkg.tar.zst")
sha256sums=('2495b063dd76b2093d2881795cd6ca53c614319f1e3a7b29f1d47f2dafae638a')

package() {
  # A matching image is required at runtime. It is declared here so makepkg
  # does not require the image package to be published before building this one.
  depends=(
    "droidloom-image=$pkgver-$pkgrel"
    'glibc'
    'gcc-libs'
    'mesa'
    'libdrm'
    'wayland'
    'libxkbcommon'
    'libpipewire'
    'pipewire'
    'systemd'
    'polkit'
    'util-linux'
    'e2fsprogs'
    'iproute2'
    'nftables'
    'iptables'
    'android-tools'
    'vulkan-icd-loader'
    'tar'
    'zstd'
  )
  optdepends=('wireplumber: automatic host audio routing (or another PipeWire session manager)')

  bsdtar -xf "$srcdir/${pkgname}-${pkgver}-${pkgrel}-x86_64-upstream.pkg.tar.zst" \
    -C "$pkgdir" --exclude='.PKGINFO' --exclude='.BUILDINFO' --exclude='.MTREE'
}
