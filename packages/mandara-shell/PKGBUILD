# Maintainer: Braian A. Diez <bdiez19@gmail.com>

pkgname=mandara-shell
pkgver=0.38.3
pkgrel=1
pkgdesc='GPU-accelerated, design-first Wayland desktop shell for MangoWM, Niri, Hyprland, Umbriel and more'
arch=('x86_64')
url='https://github.com/theHamdiz/mandara'
license=('GPL-3.0-or-later')
depends=(
  'fontconfig'
  'freetype2'
  'gcc-libs'
  'glibc'
  'libxkbcommon'
  'pam'
  'vulkan-icd-loader'
  'wayland'
)
makedepends=(
  'cargo'
  'clang'
  'cmake'
  'git'
  'pkgconf'
)
optdepends=(
  'xdg-desktop-portal: open links and follow the system appearance'
  'pipewire-pulse: sound controls, per-app volume and the visualizer'
  'noto-fonts: Arabic and fallback glyphs'
  'inter-font: the default interface font'
  'greetd: Mandara Login as your login manager'
  'accountsservice: Studio user management'
  'udisks2: the Drives panel'
  'upower: battery details'
  'power-profiles-daemon: power profiles'
  'geoclue: location for weather and prayer times'
  'networkmanager: the Network panel'
  'sound-theme-freedesktop: shell sounds'
)
provides=('mandara')
conflicts=('mandara' 'mandara-shell-bin' 'mandara-shell-git')
backup=('etc/pam.d/mandara-lock')
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        '0001-umbriel-overview-wallpaper.patch')
sha256sums=('a8841207b2da769db9684b7801d21c84531e346ac44a196d376db4179e2ad19e'
            'f10f4cd14681f98d23e4cadfd6501d2c8057e4df7de7e1e29fdad724dca91481')

_srcdir="mandara-${pkgver}"

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  # Umbriel's overview mirrors only the layer root: carry a small wallpaper
  # copy there while the full-resolution planes stay on child subsurfaces.
  patch -N -p1 -i "$srcdir/0001-umbriel-overview-wallpaper.patch"
  # Keep the build script from reading the PKGBUILD clone's git revision.
  export GIT_CEILING_DIRECTORIES="$srcdir"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # makepkg.conf supplies -C target-cpu=x86-64-v3 and the matching linker note.
  cargo build --frozen --release -p mandara-app
  # Language packs for the built version (Mandara reads only its own).
  v="$(target/release/mandara --version | cut -d' ' -f2)"
  cargo run --frozen --quiet -p xtask -- langpacks --version "$v" --dir "target/langpacks/$v"
}

check() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export GIT_CEILING_DIRECTORIES="$srcdir"
  cargo test --frozen --release -p mandara-config -p mandara-theme -p mandara-i18n
}

package() {
  cd "$_srcdir"
  install -Dm755 target/release/mandara "$pkgdir/usr/bin/mandara"
  install -Dm644 packaging/org.mandara.studio.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 packaging/org.mandara.studio.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 packaging/pam/mandara-lock "$pkgdir/etc/pam.d/mandara-lock"
  install -d "$pkgdir/usr/share/mandara/locales"
  cp -r --no-preserve=ownership target/langpacks/. "$pkgdir/usr/share/mandara/locales/"
  install -Dm644 README.md PLUGINS.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE.md COPYRIGHT.md -t "$pkgdir/usr/share/licenses/$pkgname/"
}
