# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=strider
pkgver=1.0.0
pkgrel=1
pkgdesc='Keyboard-driven, ranger-style file manager for Wayland'
arch=('x86_64')
url='https://github.com/rockorager/strider'
license=('MIT')
depends=(
  'dbus'
  'fontconfig'
  'freetype2'
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  'libarchive'
  'libxkbcommon'
  'shared-mime-info'
  'vulkan-icd-loader'
  'vulkan-driver'
  'wayland'
)
makedepends=(
  'cargo'
  'git'
  'pkgconf'
)
optdepends=(
  'ffmpeg: video previews'
  'poppler: PDF previews'
  'xdg-desktop-portal: use Strider as the file chooser'
)
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('db7463318917ba9c270a7dc8d21517a16490842398450340785f0e5f12c219a5')

_srcdir="${pkgname}-${pkgver}"

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  # Keywork is pinned to a git revision in Cargo.lock; fetch it once here.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
  cargo build --frozen --release -p strider
}

package() {
  cd "$_srcdir"

  install -Dm755 target/release/strider "$pkgdir/usr/bin/strider"

  # Upstream's install stage substitutes @PREFIX@ with the installation
  # prefix; D-Bus starts the service by absolute path, without using PATH.
  local _id='dev.rockorager.Strider' _file
  for _file in "$_id.desktop" "$_id.Chooser.desktop"; do
    sed "s|@PREFIX@|/usr|g" "data/$_file" | \
      install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$_file"
  done
  for _file in "$_id.service" 'org.freedesktop.impl.portal.desktop.strider.service'; do
    sed "s|@PREFIX@|/usr|g" "data/$_file" | \
      install -Dm644 /dev/stdin "$pkgdir/usr/share/dbus-1/services/$_file"
  done

  install -Dm644 data/strider.portal \
    "$pkgdir/usr/share/xdg-desktop-portal/portals/strider.portal"
  install -Dm644 "data/$_id.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_id.svg"
  install -Dm644 "data/$_id.metainfo.xml" "$pkgdir/usr/share/metainfo/$_id.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
