# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=herdr-app
pkgver=0.1.18
pkgrel=1
pkgdesc='Native desktop workspace for terminals and coding agents that keep running'
arch=('x86_64')
url='https://github.com/herdrdev/herdr-app'
license=('Apache-2.0')
depends=(
  'gcc-libs'
  'hicolor-icon-theme'
  'libgcc'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'vulkan-icd-loader'
  'wayland'
  'zstd'
)
makedepends=(
  'cargo'
  'clang'
  'fontconfig'
  'freetype2'
  'git'
  'pkgconf'
  'zstd'
)
optdepends=(
  'herdr-tui: background terminal runtime'
  'vulkan-intel: Vulkan driver for Intel GPUs'
  'vulkan-radeon: Vulkan driver for AMD GPUs'
  'wl-clipboard: clipboard support on Wayland'
  'xclip: clipboard support on X11'
)
conflicts=('herdr-app-bin' 'herdr-app-desktop-bin')
options=('!lto')
# ghostty-sys requires Zig 0.16; Arch ships newer, so pin the toolchain.
# Keep this revision in sync with vendor/ghostty at the packaged tag.
_ghostty_sha1=291fd050b9e9c293c8adb6a140742649b7e42d3a
_zig_version=0.16.0
_zig_archive="zig-x86_64-linux-${_zig_version}.tar.xz"
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
  "ghostty-${_ghostty_sha1}.tar.gz::https://github.com/ghostty-org/ghostty/archive/${_ghostty_sha1}.tar.gz"
  "https://ziglang.org/download/${_zig_version}/${_zig_archive}"
  'herdr-app.desktop'
)
sha256sums=(
  '0c442fd54231dee2aca661661b50f4177ca04b55966c572f26cf06c629e9e59d'
  'f35b464f1aee22ffda9f6359038b9ad18a784342b4a4fa1cb97a79fb9ade79a4'
  '70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00'
  '2cc1199525a1bac6364a7397363f96a00db3faaf51aea049f9d4a7f694ef885a'
)

_srcdir="${pkgname}-${pkgver}"

prepare() {
  cd "$_srcdir"

  bsdtar -xf "$srcdir/$_zig_archive" -C "$srcdir"
  local zig="$srcdir/zig-x86_64-linux-${_zig_version}/zig"
  [[ -x "$zig" ]] || { printf 'error: Zig %s missing from source archive\n' "$_zig_version" >&2; return 1; }

  # Upstream's git submodule is not in the source archive; use the pinned
  # Ghostty commit fetched above.
  rm -rf vendor/ghostty
  mv "$srcdir/ghostty-$_ghostty_sha1" vendor/ghostty

  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$_srcdir"

  local zig="$srcdir/zig-x86_64-linux-${_zig_version}/zig"
  export CARGO_TARGET_DIR=target
  export ZIG="$zig"
  export PATH="$(dirname "$zig"):$PATH"
  export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-global-cache"
  export ZSTD_SYS_USE_PKG_CONFIG=1
  # Do not let cargo walk out of the source tree when resolving git sources.
  export GIT_CEILING_DIRECTORIES="$srcdir"
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"

  cargo build --frozen --release
}

package() {
  cd "$_srcdir"

  install -Dm755 target/release/herdr-app "$pkgdir/usr/bin/herdr-app"
  install -Dm644 "$srcdir/herdr-app.desktop" \
    "$pkgdir/usr/share/applications/herdr-app.desktop"
  install -Dm644 assets/icons/herdr-ui-icon-clean.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/herdr-app.svg"
  install -Dm644 LICENSE THIRD-PARTY-NOTICES -t "$pkgdir/usr/share/licenses/$pkgname/"
}
