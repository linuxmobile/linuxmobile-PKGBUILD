# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=lui
pkgver=0.13.0
pkgrel=1
pkgdesc='TUI file manager written in Zig'
arch=('x86_64')
url='https://codeberg.org/lukeflo/lui'
license=('GPL-3.0-or-later')
depends=('glibc')
makedepends=('zig')
_commit=ff0a84c630170c373d52bae8a3842bac9b663c9e
source=("${pkgname}-${pkgver}-${_commit}.tar.gz::https://codeberg.org/lukeflo/lui/archive/${_commit}.tar.gz")
sha256sums=('4c9cfe524a523ee46ffa36268e034592fd1f996db6c70565bfb2d42eca780f96')

_srcdir='lui'

build() {
  cd "$_srcdir"
  zig build -Doptimize=ReleaseFast -Dcpu=x86_64_v3 \
    --prefix "$srcdir/build" \
    --cache-dir "$srcdir/.zig-cache"
}

package() {
  cd "$_srcdir"

  install -Dm755 "$srcdir/build/bin/lui" "$pkgdir/usr/bin/lui"
  install -Dm644 etc/luiconfig.zon "$pkgdir/usr/share/doc/${pkgname}/luiconfig.zon"
  install -Dm644 README.md "$pkgdir/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
