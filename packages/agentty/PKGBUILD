# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=agentty
pkgver=0.9.63
pkgrel=1
pkgdesc='Fast native C++ coding agent harness for the terminal'
_simdjson_ver=3.10.1
arch=('x86_64')
url='https://github.com/agentty-org/agentty'
license=('MIT')
depends=(
  'gcc-libs'
  'glibc'
  'libnghttp2'
  'openssl'
)
makedepends=(
  'cmake'
  'nlohmann-json'
  'ninja'
  'pkgconf'
)
optdepends=(
  'bubblewrap: default sandbox backend for bash and diagnostics tool calls'
  'openssh: `agentty airgap` sessions'
)
conflicts=('agetty' 'agentty-bin' 'agentty-git')
replaces=('agetty' 'agentty-bin' 'agentty-git')
options=('!lto')
# The GitHub release source archive carries every pinned submodule, including
# maya's nested jaal checkout. GitHub's automatic tag archive is much smaller
# and leaves those directories empty.
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz"
  "simdjson-${_simdjson_ver}.tar.gz::https://github.com/simdjson/simdjson/archive/refs/tags/v${_simdjson_ver}.tar.gz"
)
sha256sums=('e35dd3c28c8c3f00809862952cf258aa467c4e9fc3a5875c7d40512da23d09f4'
            '1e8f881cb2c0f626c56cd3665832f1e97b9d4ffc648ad9e1067c134862bba060')

_srcdir="${pkgname}-${pkgver}"
_simdjson_srcdir="simdjson-${_simdjson_ver}"

prepare() {
  cd "$_srcdir"

  # The release archive vendors all pinned submodules. Fail here, rather than
  # deep in CMake, if upstream ever ships an incomplete source tarball.
  local vendored=(
    third_party/maya/CMakeLists.txt
    third_party/maya/third_party/jaal/CMakeLists.txt
    third_party/jsonrpc-cpp/CMakeLists.txt
    third_party/acp-cpp/CMakeLists.txt
    third_party/mcp-cpp/CMakeLists.txt
    third_party/rag-cpp/CMakeLists.txt
    third_party/claybin/CMakeLists.txt
    third_party/richpaste/CMakeLists.txt
  )
  local file
  for file in "${vendored[@]}"; do
    if [[ ! -f "$file" ]]; then
      printf 'missing vendored source: %s\n' "$file" >&2
      return 1
    fi
  done
}

build() {
  cd "$_srcdir"

  # Build simdjson from the pinned source below instead of adopting whatever
  # shared simdjson ABI the build host happens to ship. The resulting binary
  # has no libsimdjson.so.* runtime dependency.
  # Disable Maya's private -O3/Graphite pass too: this repo already supplies
  # -O2/-march=x86-64-v3 globally, and the extra pass makes CI needlessly slow.
  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_FLAGS="$CFLAGS" \
    -DCMAKE_CXX_FLAGS="$CXXFLAGS" \
    -DCMAKE_C_FLAGS_RELEASE='-DNDEBUG' \
    -DCMAKE_CXX_FLAGS_RELEASE='-DNDEBUG' \
    -DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS" \
    -DCMAKE_SHARED_LINKER_FLAGS="$LDFLAGS" \
    -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
    -DBUILD_SHARED_LIBS=OFF \
    -DFETCHCONTENT_SOURCE_DIR_SIMDJSON="${srcdir}/${_simdjson_srcdir}" \
    -DAGENTTY_STANDALONE=OFF \
    -DAGENTTY_USE_MIMALLOC=OFF \
    -DAGENTTY_AUTO_INIT_SUBMODULES=OFF \
    -DAGENTTY_AUTO_PULL_SUBMODULES=OFF \
    -DAGENTTY_AUTO_PULL_MAYA=OFF \
    -DAGENTTY_BUILD_TESTS=OFF \
    -DMAYA_HEAVY_OPT=OFF \
    -DMAYA_NATIVE_TUNING=OFF \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON

  cmake --build build --target agentty
}

check() {
  cd "$_srcdir"

  # Upstream's full suite is opt-in and pulls doctest; a release smoke test
  # keeps this package reproducible without extra unreleased dependencies.
  ./build/agentty --version
}

package() {
  cd "$_srcdir"

  install -Dm755 build/agentty "$pkgdir/usr/bin/agentty"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
