# Maintainer: Braian A. Diez <bdiez19@gmail.com>
pkgname=syswatch
pkgver=0.14.5
pkgrel=1
pkgdesc='Read-only system diagnostics TUI covering CPU, memory, disks, processes, GPU, power and network'
arch=('x86_64')
url='https://github.com/matthart1983/syswatch'
license=('MIT')
depends=('glibc' 'gcc-libs' 'libpcap')
makedepends=('cargo' 'pkgconf')
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('660855f2d03dbc5cea6921a0ebd66b97d55eac3b83c27bef525802c9f189668d')

_srcdir="${pkgname}-${pkgver}"

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
  cargo build --frozen --release
}

package() {
  cd "$_srcdir"
  install -Dm755 "target/release/syswatch" "$pkgdir/usr/bin/syswatch"
  install -Dm644 README.md "$pkgdir/usr/share/doc/${pkgname}/README.md"
  install -Dm644 docs/REFERENCE.md "$pkgdir/usr/share/doc/${pkgname}/REFERENCE.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
