+  return (
+    <>
+      <SectionHeader title="Window buttons" />
+      <Group>
+        <Row anchor="appearance.windowButtons">
+          <PopUp value={windowButtons} options={WINDOW_BUTTON_CHOICES} onChange={(v) => updateSettings({ windowButtons: v })} minWidth={180} />
+        </Row>
+      </Group>
+    </>
+  );
+}
